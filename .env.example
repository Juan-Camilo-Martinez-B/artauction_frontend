# URL pública del API NestJS. Solo valores no secretos pueden usar el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Origen del gateway Socket.IO. El navegador abre esta URL; el worker de subasta la consume.
NEXT_PUBLIC_WS_URL=http://localhost:3001

# URL del API vista desde el servidor de Next.js (SSR). No se expone al navegador.
API_INTERNAL_URL=http://localhost:3001
